{
  "name": "dsh-plugin-piko-remote",
  "version": "0.3.2",
  "description": "Expose a local port to a remote piko server from DeepSeek Harness, and hand back the public URL.",
  "license": "MIT",
  "author": "friddle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/friddle/dsh-plugin-piko-remote.git"
  },
  "homepage": "https://github.com/friddle/dsh-plugin-piko-remote#readme",
  "bugs": {
    "url": "https://github.com/friddle/dsh-plugin-piko-remote/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin/piko-expose-*",
    "cordis.patch.yml",
    "README.md",
    "PLAN.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "scripts/build-helper.sh",
    "build:helper": "scripts/build-helper.sh",
    "smoke": "scripts/smoke-test.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
